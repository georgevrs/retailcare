# ACS Settings
ACS_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
ACS_CALLBACK_URL=https://<your-function-app>.azurewebsites.net/api/acs/events

# Call state persistence (REQUIRED for production – avoids losing caller ID across workers)
# Use the same Storage Account as your Function App or any Azure Storage account.
CALL_STATE_STORAGE_CONN=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
CALL_STATE_TABLE=callstate

# Speech Settings (for ACS answer_call you need the full resource endpoint)
# Required: full Speech/Cognitive Services resource URL (avoids recognition error 8565)
COGNITIVE_SERVICES_ENDPOINT=https://<your-speech-resource>.cognitiveservices.azure.com
SPEECH_KEY=your_speech_key
SPEECH_REGION=westeurope

# Azure OpenAI Settings
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_KEY=your_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# GitHub Settings
GITHUB_OWNER=your_username
GITHUB_REPO=your_repo
GITHUB_TOKEN=your_fine_grained_pat

# Dev Settings
LOG_LEVEL=INFO
